# Database: file:local.db locally, libsql://... in production
DATABASE_URL=file:local.db
# Empty locally; Turso token in production
DATABASE_AUTH_TOKEN=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; your live URL in production
BETTER_AUTH_URL=http://localhost:3000